GITHUB_REPO=your_public_repo
GITHUB_BRANCH=main
LOCAL_REPO_PATH=./your-repo  # 必须是已 clone 的本地仓库路径（相对或绝对）

# 火山引擎 TOS 配置（用于 seedream 插件的图片上传）
# 需要安装: pip install tos
VOLC_TOS_ACCESS_KEY=your_access_key
VOLC_TOS_SECRET_KEY=your_secret_key
VOLC_TOS_ENDPOINT=tos-cn-beijing.volces.com
VOLC_TOS_REGION=cn-beijing
VOLC_TOS_BUCKET=your_bucket_name
